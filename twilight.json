    { "id": "footer_is_dark", "type": "boolean", "label": "تفعيل التذييل الداكن", "format": "switch", "value": false, "selected": false },
    { "id": "enable_add_product_toast", "type": "boolean", "label": "إظهار تنبيه إضافة المنتج للسلة", "format": "switch", "value": true, "selected": true }
  ]
}
