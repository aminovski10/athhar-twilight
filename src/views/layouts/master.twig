<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ store.description|default('أثر — عطور وعناية مختارة لترافق تفاصيل يومك.') }}">
  {% hook 'head:start' %}
  <link rel="stylesheet" href="{{ 'app.css' | asset }}">
  {% if theme.font %}<link rel="stylesheet" href="{{ theme.font.path|cdn }}">{% endif %}
  <style>
    :root { --font-main: '{{ theme.font.name|default('DINNextLTArabic-Regular') }}'; --color-primary: {{ theme.color.primary|default('#ad6948') }}; --color-primary-reverse: {{ theme.color.reverse_text|default('#fffdf8') }}; }
  </style>
  {% hook 'head:end' %}
</head>
<body id="app" class="athhar-theme {{ theme.settings.get('footer_is_dark') ? 'footer-is-dark' : 'footer-is-light' }}">
  {% hook 'body:start' %}
  <div class="app-shell">
    {% component 'header.header' %}
    <main id="main-content" role="main">{% block content %}{% endblock %}</main>
    {% component 'footer.footer' %}
  </div>
  {% if theme.settings.get('enable_add_product_toast', true) %}<salla-add-product-toast></salla-add-product-toast>{% endif %}
  <salla-search></salla-search>
  <salla-login-modal></salla-login-modal>
  {% hook 'body:end' %}
  <script defer src="{{ 'app.js' | asset }}"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
